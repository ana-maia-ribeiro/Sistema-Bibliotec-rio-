package com.bibliotecario.backend.modal.entites;

import java.util.Objects;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import jakarta.persistence.Table;

@Entity
@Table(name = "Collection")
public class Collection {
	
	@Id
	@GeneratedValue(strategy = GenerationType.IDENTITY)
	private Long id;
	
	@Column(nullable = false)
	private Bookcase bookcase;
	
	@Column(nullable = false)
	private Publisher publisher;
	
	private Float quantity;
	
	@Column(nullable = false)
	private String title;
	
	@Column(nullable = false)
	private TypeBook typebook;
	
	public Collection() {
		
	}

	public Collection(Long id, Bookcase bookcase, Publisher publisher, Float quantity, String title,
			TypeBook typebook) {
		this.id = id;
		this.bookcase = bookcase;
		this.publisher = publisher;
		this.quantity = quantity;
		this.title = title;
		this.typebook = typebook;
	}

	public Long getId() {
		return id;
	}

	public Bookcase getBookcase() {
		return bookcase;
	}

	public void setBookcase(Bookcase bookcase) {
		this.bookcase = bookcase;
	}

	public Publisher getPublisher() {
		return publisher;
	}

	public void setPublisher(Publisher publisher) {
		this.publisher = publisher;
	}

	public Float getQuantity() {
		return quantity;
	}

	public void setQuantity(Float quantity) {
		this.quantity = quantity;
	}

	public String getTitle() {
		return title;
	}

	public void setTitle(String title) {
		this.title = title;
	}

	public TypeBook getTypebook() {
		return typebook;
	}

	public void setTypebook(TypeBook typebook) {
		this.typebook = typebook;
	}

	@Override
	public int hashCode() {
		return Objects.hash(id);
	}

	@Override
	public boolean equals(Object obj) {
		if (this == obj)
			return true;
		if (obj == null)
			return false;
		if (getClass() != obj.getClass())
			return false;
		Archive other = (Archive) obj;
		return Objects.equals(id, other.id);
	}
	
	

}
