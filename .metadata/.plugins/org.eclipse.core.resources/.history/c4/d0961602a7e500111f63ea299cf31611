package com.bibliotecario.backend.modal.entites;


import java.util.Objects;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import jakarta.persistence.JoinColumn;
import jakarta.persistence.ManyToOne;
import jakarta.persistence.Table;
import jakarta.validation.constraints.NotNull;

/**
 * Exemplar fisico de um livro. Cada lote (Archive) e destrinchado em varios
 * Books, e cada um recebe um codigo unico de 7 digitos gerado pelo sistema.
 */
@Entity
@Table(name = "Book")
public class Book {

	@Id
	@GeneratedValue(strategy = GenerationType.IDENTITY)
	private Long id;

	// Gerado automaticamente pelo BookService (1000000 a 9999999)
	@Column(nullable = false, unique = true)
	private Integer code;

	// Lote do acervo ao qual o exemplar pertence
	@NotNull
	@ManyToOne(optional = false)
	@JoinColumn(name = "id_archive", nullable = false)
	private Archive archive;

	public Book() {

	}

	public Book(Long id, Integer code, Archive archive) {
		this.id = id;
		this.code = code;
		this.archive = archive;
	}

	public Long getId() {
		return id;
	}

	public Integer getCode() {
		return code;
	}

	public void setCode(Integer code) {
		this.code = code;
	}

	public Archive getArchive() {
		return archive;
	}

	public void setArchive(Archive archive) {
		this.archive = archive;
	}

	@Override
	public int hashCode() {
		return Objects.hash(id);
	}

	@Override
	public boolean equals(Object obj) {
		if (this == obj)
			return true;
		if (obj == null)
			return false;
		if (getClass() != obj.getClass())
			return false;
		Book other = (Book) obj;
		return Objects.equals(id, other.id);
	}

}
